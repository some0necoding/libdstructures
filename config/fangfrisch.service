[Unit]
Description=Download fangfrisch databases' virus definition files
ConditionPathExists=/var/lib/fangfrisch/db.sqlite

[Service]
Type=oneshot
User=clamav
WorkingDirectory=/var/lib/fangfrisch
ExecStart=/var/lib/fangfrisch/venv/bin/fangfrisch – conf /etc/fangfrisch.conf refresh

[Install]
WantedBy=multi-user.target